# Shared local file. Production: set each variable on the service that needs it.

# --- API (apps/api) ---
DATABASE_URL=postgres://USER:PASSWORD@pooled.db.prisma.io:5432/postgres?sslmode=require
DIRECT_URL=postgres://USER:PASSWORD@db.prisma.io:5432/postgres?sslmode=require
PORT=4000
# Comma-separated browser origins allowed to call the API (no path, no trailing slash).
# Production: `fly secrets set WEB_ORIGIN=https://your-web-origin`
WEB_ORIGIN=http://localhost:5173

# --- Web (apps/web) ---
# Public API origin baked in at `vite build`. No trailing slash.
# Local API: http://localhost:4000
# Production API (Fly.io): https://personal-record-api.fly.dev
VITE_API_URL=http://localhost:4000
